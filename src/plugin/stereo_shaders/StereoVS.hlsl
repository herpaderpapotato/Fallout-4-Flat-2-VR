// StereoVS.hlsl - PROTOTYPE (unbuilt, stereo PoC). Replacement vertex shaders compiled at runtime
// with D3DCompile (vs_5_0) and bound in place of the engine's VS for converted draws.
//
// Defines (set by the plugin per target family, see src/StereoTargets.inl):
//   STEREO_FAMILY   1 = g008 static "PTNB"  (POSITION TEXCOORD NORMAL BINORMAL)
//                   2 = g008 static "PTNBC" (+ COLOR)
//                   0 = category B example (g004_vs_00000000: POSITION only, WVP premultiplied in cb2[0..3])
//   STEREO_FAITHFUL 1 = reproduce the engine VS outputs exactly (blobs 78f8f2be.. / d59ecb3a..), so the
//                       engine's GBuffer pixel shader can stay bound.
//                   0 = simplified outputs for StereoDebugPS.hlsl (the PS is replaced as well).
//
// Input signature rule: the engine builds its input layouts from the vertex desc against the ORIGINAL
// VS's bytecode (BSGraphics::CreateInputLayout 1823210, verified), so our ISGN must declare the same
// non-system elements, in the same order/registers/masks. SV_InstanceID is a system value generated by
// the IA (not by the layout) and is appended last. tools/check_shaders.py verifies this offline and
// DxbcSig.h re-verifies it at runtime before a replacement is ever bound.

#include "StereoCommon.hlsli"

#ifndef STEREO_FAMILY
#define STEREO_FAMILY 1
#endif
#ifndef STEREO_FAITHFUL
#define STEREO_FAITHFUL 1
#endif

// Engine constant buffers, declared as raw rows exactly as the original bytecode indexes them.
cbuffer EngineMaterial : register(b1) { float4 cb1[1]; };   // [0] = uv scale (zw) / offset (xy)
cbuffer EngineGeometry : register(b2) { float4 cb2[7]; };   // [0..3] World (3x4 + row 3), [4..6] previous World
cbuffer EnginePerFrame : register(b12) { float4 cb12[47]; }; // [0..2] view rotation, [8..11] ViewProj (T),
                                                            // [35] PosAdjust, [36] previous PosAdjust

struct VSIn
{
    float4 pos : POSITION0;       // xyz position, w = normal.x (packed vertex format)
#if STEREO_FAMILY != 0
    float2 uv  : TEXCOORD0;
    float4 nrm : NORMAL0;         // unorm8: xyz *2-1, w = packed component
    float4 bin : BINORMAL0;
#endif
#if STEREO_FAMILY == 2
    float4 col : COLOR0;
#endif
    uint   iid : SV_InstanceID;   // appended system value (not part of the IA layout)
};

#if STEREO_FAMILY != 0 && STEREO_FAITHFUL
// Same output signature as the engine VS (registers o0..o5[/o6]) + SV_ClipDistance0 appended last, so the
// engine PS (which reads a prefix of these registers) links unchanged, as in Fallout 4 VR's shaders.
struct VSOut
{
    float4 pos  : SV_POSITION;
    float3 t0   : TEXCOORD0;      // view-space TBN rows (cb12[0..2] * World * {n0, bin, nrm})
    float3 t1   : TEXCOORD1;
    float3 t2   : TEXCOORD2;
    float4 t3   : TEXCOORD3;      // xyz camera-relative world position, w = u
    float4 t4   : TEXCOORD4;      // xyz previous-frame camera-relative position, w = v
#if STEREO_FAMILY == 2
    float4 col  : COLOR0;
#endif
    float  clip : SV_ClipDistance0;
};
#else
// Simplified outputs for the debug PS.
struct VSOut
{
    float4 pos   : SV_POSITION;
    float3 nrmW  : TEXCOORD0;     // world-space normal (approximate, unnormalised world 3x3)
    float3 world : TEXCOORD1;     // absolute world position (camera-relative + PosAdjust)
    float  viewZ : TEXCOORD2;     // eye view-space depth (= clip w), for the depth-band encoding
    nointerpolation uint eye : TEXCOORD3;
    float  clip  : SV_ClipDistance0;
};
#endif

VSOut main(VSIn v)
{
    VSOut o;
    const uint eye = v.iid & 1;
    const float4 p = float4(v.pos.xyz, 1.0f);

#if STEREO_FAMILY != 0
    // Camera-relative world position, exactly as the engine VS: rows cb2[0..2] with PosAdjust removed.
    const float4 w0 = float4(cb2[0].xyz, cb2[0].w - cb12[35].x);
    const float4 w1 = float4(cb2[1].xyz, cb2[1].w - cb12[35].y);
    const float4 w2 = float4(cb2[2].xyz, cb2[2].w - cb12[35].z);
    const float4 rel = float4(dot(w0, p), dot(w1, p), dot(w2, p), dot(cb2[3], p));
    // Mono would be: dot(cb12[8..11], rel). Per eye: VP_e from b5.
    const float4 clipEye = mul(rel, gEyeViewProj[eye]);
#else
    // Category B: premultiplied mono WVP in cb2[0..3], then the per-eye clip-space delta.
    const float4 clipMono = float4(dot(cb2[0], p), dot(cb2[1], p), dot(cb2[2], p), dot(cb2[3], p));
    const float4 clipEye = mul(clipMono, gEyeFromMonoClip[eye]);
    const float4 rel = float4(0, 0, 0, 1);  // not available for category B
#endif

    const StereoClip sc = StereoFinish(clipEye, eye);
    o.pos = sc.pos;
    o.clip = sc.clip;

#if STEREO_FAMILY != 0 && STEREO_FAITHFUL
    // Transcription of g008_vs_0100001a / 0100001b (work/shaders/flat/disasm), outputs o1..o6.
    const float3 n0 = normalize(float3(v.pos.w, v.nrm.w * 2.0f - 1.0f, v.bin.w * 2.0f - 1.0f));
    const float3 nb = normalize(v.bin.xyz * 2.0f - 1.0f);
    const float3 nn = normalize(v.nrm.xyz * 2.0f - 1.0f);
    const float4 c0 = float4(cb2[0].x, cb2[1].x, cb2[2].x, cb2[3].x);
    const float4 c1 = float4(cb2[0].y, cb2[1].y, cb2[2].y, cb2[3].y);
    const float4 c2 = float4(cb2[0].z, cb2[1].z, cb2[2].z, cb2[3].z);
    float3 r = float3(dot(cb12[0], c0), dot(cb12[0], c1), dot(cb12[0], c2));
    o.t0 = float3(dot(r, n0), dot(r, nb), dot(r, nn));
    r = float3(dot(cb12[1], c0), dot(cb12[1], c1), dot(cb12[1], c2));
    o.t1 = float3(dot(r, n0), dot(r, nb), dot(r, nn));
    r = float3(dot(cb12[2], c0), dot(cb12[2], c1), dot(cb12[2], c2));
    o.t2 = float3(dot(r, n0), dot(r, nb), dot(r, nn));
    const float2 uv = v.uv * cb1[0].zw + cb1[0].xy;
    o.t3 = float4(rel.xyz, uv.x);
    const float4 q0 = float4(cb2[4].xyz, cb2[4].w - cb12[36].x);
    const float4 q1 = float4(cb2[5].xyz, cb2[5].w - cb12[36].y);
    const float4 q2 = float4(cb2[6].xyz, cb2[6].w - cb12[36].z);
    o.t4 = float4(dot(q0, p), dot(q1, p), dot(q2, p), uv.y);
#if STEREO_FAMILY == 2
    o.col = float4(exp2(log2(v.col.rgb) * 2.2f), v.col.a);  // engine: log, *2.2, exp (gamma -> linear)
#endif
    // Known approximation (PoC): view-dependent side outputs (TBN in view space via cb12[0..2], motion
    // vectors from t3/t4 in the PS) stay centre-eye. Exact for parallel eyes (rotation shared); motion
    // vectors are wrong per eye -> TAA / motion blur off for the PoC.
#else
#if STEREO_FAMILY != 0
    const float3 nn = v.nrm.xyz * 2.0f - 1.0f;
    o.nrmW = float3(dot(cb2[0].xyz, nn), dot(cb2[1].xyz, nn), dot(cb2[2].xyz, nn));
#else
    o.nrmW = float3(0, 0, 1);
#endif
    o.world = rel.xyz + cb12[35].xyz;
    o.viewZ = clipEye.w;
    o.eye = eye;
#endif
    return o;
}
