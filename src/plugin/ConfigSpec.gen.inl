{ "Render", "Performance", "Performance", "bGpuQueueAdaptive", RowType::kBool, "1", 0.0f, 1.0f, 0.1f, "", "GPU queue 0: relax when frames are late", "Only with 'GPU frames queued at most' = 0. While frames miss the display period the wait for the GPU only costs frame rate, so 1 frame may be queued until CPU + GPU fit the period again. Changes head-pose timing while relaxed.", "@reload", true },
{ "Render", "Performance", "Performance", "bDirectEyeCopy", RowType::kBool, "1", 0.0f, 1.0f, 0.1f, "", "Direct eye copy", "Each eye's part of the frame is copied straight into the headset's image (1 copy instead of 3 full-size passes per eye). Off = the previous path.", "@reload", true },
