{ "FRIK", "Body", "FRIK", "bShowHeadOutsideFirstPerson", RowType::kBool, "1", 0.0f, 1.0f, 0.1f, "", "Head always shown outside first person", "VATS playback, third person and other game cameras (not the free camera) never show the player without a head, whatever hid it. Live.", "frik reread", true },
{ "FRIK", "Body", "FRIK", "bSkinRestoreLiveBones", RowType::kBool, "1", 0.0f, 1.0f, 0.1f, "", "Body skin back on the live bones", "Leaving first person, every body / head / outfit piece is skinned from the animated bones again (none left on FRIK's last first-person pose). Live.", "frik reread", true },
{ "FRIK", "Body", "FRIK", "bAnimatedLegs", RowType::kBool, "1", 0.0f, 1.0f, 0.1f, "", "VRIK-style legs", "Moving: the legs follow the game's walk / run / strafe animation (needs Body animation graph). Standing: planted feet with short steps. Off: FRIK's walk.", "frik reread", true },
